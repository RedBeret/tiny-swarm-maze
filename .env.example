SWARM_ENV=dev
SWARM_LOG_LEVEL=INFO
SWARM_FRONTEND_ORIGIN=http://localhost:5173
SWARM_TICK_RATE_HZ=5
SWARM_MAX_SESSIONS=32
SWARM_SESSION_TTL_SECONDS=3600
SWARM_TELEMETRY_DB_PATH=/app/data/telemetry.sqlite3
SWARM_DEFAULT_DIFFICULTY=standard
SWARM_DEFAULT_PROFILE=rules

SWARM_LLM_ENABLED=true
SWARM_LLM_PROVIDER=ollama
SWARM_FEATURE_PLANNER_ENABLED=false
SWARM_FEATURE_TELEMETRY_ENABLED=true

SWARM_OLLAMA_HOST=http://host.docker.internal:11434
SWARM_OLLAMA_MODEL=llama3.1
SWARM_OLLAMA_API_KEY=
SWARM_OLLAMA_TEMPERATURE=0.2
SWARM_OLLAMA_TIMEOUT_MS=5000
SWARM_OLLAMA_MAX_RETRIES=2
SWARM_OLLAMA_BACKOFF_MS=250

VITE_API_BASE_URL=http://localhost:8000
